# --- LLM / embeddings (provider-agnostic via LangChain init_chat_model) ---
# Any OpenAI-compatible key works with the defaults below.
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Database ---
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5434/ragkit

# --- CORS ---
# Comma-separated origins the API accepts. Default covers the dev frontend on
# :3000; set it when the frontend runs on another port or host.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth ---
# REQUIRED — the app refuses to start with a weak/empty value. Generate one:
#   openssl rand -hex 32
JWT_SECRET=
# Demo users seeded by `make seed`: viewer@example.com / analyst@example.com /
# admin@example.com, password $SEED_PASSWORD (default demo1234).

# --- Observability (optional — leave empty to disable tracing) ---
# EU region: https://cloud.langfuse.com  (data stays in the EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OTLP spans (GenAI semantic conventions). Empty endpoint = tracing off: no
# exporter, no background thread, no network call. Base URL only — "/v1/traces"
# is appended. Langfuse ingests OTLP at $LANGFUSE_HOST/api/public/otel and needs
# an Authorization header of "Basic <base64 public:secret>".
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Structured JSON logs on stdout, one object per line, always on.
LOG_LEVEL=INFO

# USD per million tokens for LLM_MODEL, from your provider's pricing page. Left
# at 0 the spans carry token counts and no cost — an unpriced call gets no
# number rather than a 0.0 that reads as free.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# --- Retrieval ---
# Optional reranker: "none" (default) or "cohere" (needs COHERE_API_KEY)
RERANKER=none
COHERE_API_KEY=
