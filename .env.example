# --- LLM / embeddings (provider-agnostic via LangChain init_chat_model) ---
# Any OpenAI-compatible key works with the defaults below.
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Database ---
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/ragkit

# --- Auth ---
# openssl rand -hex 32
JWT_SECRET=change-me
# Demo users are seeded by `make seed` with role-based access (viewer/analyst/admin).

# --- Observability (optional — leave empty to disable tracing) ---
# EU region: https://cloud.langfuse.com  (data stays in the EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Retrieval ---
# Optional reranker: "none" (default) or "cohere" (needs COHERE_API_KEY)
RERANKER=none
COHERE_API_KEY=
